<div class="bb-chat-card {{#if isResult}}bb-chat-card--result{{else}}bb-chat-card--published{{/if}}">
  <p class="bb-kicker">{{#if isResult}}Contract Update{{else}}New Contract Published{{/if}}</p>
  {{#if bounty.title}}<h3>{{bounty.title}}</h3>{{/if}}
  <dl>
    <div><dt>Mission type</dt><dd>{{bounty.missionType}}</dd></div>
    <div><dt>{{bounty.subjectLabel}}</dt><dd>{{bounty.missionSubject}}</dd></div>
    {{#each bounty.missionFacts}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}
    <div><dt>Reward</dt><dd>{{bounty.rewardLabel}}</dd></div>
    <div><dt>{{bounty.dangerLabel}}</dt><dd>{{bounty.threatLevel}}</dd></div>
    <div><dt>Faction</dt><dd>{{bounty.faction}}</dd></div>
    <div><dt>Status</dt><dd>{{bounty.statusLabel}}</dd></div>
  </dl>
  <button type="button" data-bb-open-handout><i class="fa-solid fa-file-lines" aria-hidden="true"></i> {{localize "BOUNTYBOARD.Handout.Open"}}</button>
</div>
