<section class="bb-editor">
  {{#unless canEdit}}
    <p class="bb-empty">Only a GM can edit bounty contracts.</p>
  {{else}}
    <input type="hidden" name="id" value="{{bounty.id}}" />

    <div class="bb-editor-grid">
      <label>
        <span>Mission type</span>
        <select name="missionTypeChoice">
          {{#each missionTypes}}<option value="{{this}}" {{#if (bbEq ../bounty.missionType this)}}selected{{/if}}>{{this}}</option>{{/each}}
          <option value="">Other…</option>
        </select>
      </label>
      <label data-mission-name hidden>
        <span>Your mission type</span>
        <input type="text" name="missionTypeName" maxlength="80" placeholder="Salvage, Diplomacy, Sabotage…" disabled />
      </label>

      <label>
        <span>{{localize "BOUNTYBOARD.Editor.ContractId"}}</span>
        <input class="bb-contract-id-input" type="text" name="contractId" value="{{bounty.contractId}}" maxlength="32" autocomplete="off" spellcheck="false" required />
      </label>
      <label>
        <span>Title</span>
        <input type="text" name="title" value="{{bounty.title}}" />
      </label>
      <label data-mission-fields="Bounty">
        <span>Target Name</span>
        <input type="text" name="targetName" value="{{bounty.targetName}}" required />
      </label>
      <label>
        <span>Reward Amount</span>
        <input type="number" min="0" step="1" name="rewardAmount" value="{{bounty.rewardAmount}}" required />
      </label>
      <label>
        <span>Reward Currency</span>
        <input type="text" name="rewardCurrency" value="{{bounty.rewardCurrency}}" required />
      </label>
      <label>
        <span data-danger-label>Threat Level</span>
        <select name="threatLevel" required>
          {{#each threatLevels as |threat|}}
            <option value="{{threat}}" {{#if (bbEq ../bounty.threatLevel threat)}}selected{{/if}}>{{threat}}</option>
          {{/each}}
        </select>
      </label>
      <label>
        <span>Status</span>
        <select name="status">
          {{#each statuses as |status|}}
            <option value="{{status}}" {{#if (bbEq ../bounty.status status)}}selected{{/if}}>{{status}}</option>
          {{/each}}
        </select>
      </label>
      <label>
        <span>Issuer / Faction</span>
        <input type="text" name="faction" value="{{bounty.faction}}" />
      </label>
      <label>
        <span>Location</span>
        <input type="text" name="location" value="{{bounty.location}}" />
      </label>
      <label data-mission-fields="Transport" hidden>
        <span>Cargo</span>
        <input type="text" name="cargo" value="{{bounty.cargo}}" />
      </label>
      <label data-mission-fields="Transport" hidden>
        <span>Pickup</span>
        <input type="text" name="pickup" value="{{bounty.pickup}}" />
      </label>
      <label data-mission-fields="Transport" hidden>
        <span>Destination</span>
        <input type="text" name="destination" value="{{bounty.destination}}" />
      </label>
      <label data-mission-fields="Transport" hidden>
        <span>Delivery deadline</span>
        <input type="text" name="deadline" value="{{bounty.deadline}}" />
      </label>
      <label data-mission-fields="Exploration" hidden>
        <span>Region</span>
        <input type="text" name="region" value="{{bounty.region}}" />
      </label>
      <label data-mission-fields="Exploration" hidden>
        <span>Known hazards</span>
        <input type="text" name="hazards" value="{{bounty.hazards}}" />
      </label>
      <label data-mission-fields="other" hidden>
        <span>Objective</span>
        <input type="text" name="objective" value="{{bounty.objective}}" />
      </label>
      <label class="bb-editor-wide">
        <span>Short Description</span>
        <textarea name="description" rows="2">{{bounty.description}}</textarea>
      </label>
      <label class="bb-editor-wide">
        <span>Long Description</span>
        <textarea name="longDescription" rows="5">{{bounty.longDescription}}</textarea>
      </label>
      <label class="bb-editor-wide">
        <span>Tags</span>
        <input type="text" name="tags" value="{{bounty.tagsText}}" placeholder="Smuggling, Rescue, Investigation" />
      </label>
      <label class="bb-editor-image">
        <span>Image</span>
        <input type="text" name="image" value="{{bounty.image}}" />
        <button type="button" data-action="browseImage" title="Browse image"><i class="fa-solid fa-folder-open"></i></button>
      </label>
      <label>
        <span>Linked Journal</span>
        <select name="linkedJournalId">
          <option value="">None</option>
          {{#each journals as |journal|}}
            <option value="{{journal.id}}" {{#if (bbEq ../bounty.linkedJournalId journal.id)}}selected{{/if}}>{{journal.name}}</option>
          {{/each}}
        </select>
      </label>
      <label>
        <span>{{localize "BOUNTYBOARD.Editor.Scene"}}</span>
        <select name="sceneId">
          <option value="">{{localize "BOUNTYBOARD.Editor.NoScene"}}</option>
          {{#each scenes as |scene|}}
            <option value="{{scene.id}}" {{#if (bbEq ../bounty.sceneId scene.id)}}selected{{/if}}>{{scene.name}}</option>
          {{/each}}
        </select>
      </label>
      <label class="bb-checkbox bb-checkbox-compact">
        <input type="checkbox" name="published" {{#if bounty.published}}checked{{/if}} />
        <span>Published to players</span>
      </label>
    </div>

    <footer class="bb-editor-actions">
      {{#if canDelete}}<button type="button" class="bb-danger-action" data-action="deleteContract"><i class="fa-solid fa-trash" aria-hidden="true"></i>{{localize "BOUNTYBOARD.Action.Delete"}}</button>{{/if}}
      <button type="submit" class="bb-primary"><i class="fa-solid fa-floppy-disk"></i>Save Contract</button>
    </footer>
  {{/unless}}
</section>
