<section class="security-camera-manager">
  <aside class="security-camera-monitor-list">
    <header>
      <h2><span class="security-camera-network-icon" aria-hidden="true"></span> Camera Network</h2>
      <span class="security-camera-count" aria-label="Registered cameras">{{cameras.length}}</span>
    </header>

    <div class="security-camera-list">
      {{#if hasCameras}}
        {{#each cameras}}
          <button type="button" class="security-camera-list-item {{statusClass}} {{#if isSelected}}active{{/if}}" aria-pressed="{{#if isSelected}}true{{else}}false{{/if}}" data-security-camera-id="{{id}}">
            <i class="fa-solid fa-video security-camera-device-icon" aria-hidden="true"></i>
            <span class="security-camera-device-name" title="{{name}}">{{name}}</span>
            <small title="{{location}}">{{location}}</small>
            <span class="security-camera-device-status">{{status}}</span>
          </button>
        {{/each}}
      {{else}}
        <p class="security-camera-empty">No cameras registered.</p>
      {{/if}}
    </div>

    <div class="security-camera-list-actions">
      <button type="button" data-security-camera-action="new"><i class="fa-solid fa-plus" aria-hidden="true"></i> New</button>
      <button type="button" data-security-camera-action="duplicate"><i class="fa-solid fa-copy" aria-hidden="true"></i> Duplicate</button>
      <button type="button" data-security-camera-action="delete"><i class="fa-solid fa-trash-can" aria-hidden="true"></i> Delete</button>
    </div>
  </aside>

  {{#if selectedCamera}}
    <section class="security-camera-monitor-preview {{selectedCamera.statusClass}}">
      <header>
        <div>
          <span class="security-camera-kicker">Selected Feed</span>
          <h3>{{selectedCamera.name}}</h3>
        </div>
        <strong>{{selectedCamera.status}}</strong>
      </header>

      <div class="security-camera-monitor-display">
      <div class="security-camera-preview-frame">
        {{#if selectedCamera.canDisplayImage}}
          <img src="{{selectedCamera.image}}" alt="{{selectedCamera.name}}">
        {{else}}
          <div class="security-camera-placeholder">{{selectedCamera.signalLabel}}</div>
        {{/if}}
      </div>

      <div class="security-camera-monitor-readout"><span>{{selectedCamera.id}}</span><span>{{selectedCamera.feedSource}}</span></div>
      </div>
      <dl>
        <dt>Location</dt>
        <dd>{{selectedCamera.location}}</dd>
        <dt>Scene</dt>
        <dd>{{selectedCamera.sceneName}}</dd>
        <dt>Source</dt>
        <dd>{{selectedCamera.feedSource}}</dd>
        <dt>Region</dt>
        <dd>{{selectedCamera.regionName}}</dd>
        <dt>Mode</dt>
        <dd>{{selectedCamera.displayMode}}</dd>
        <dt>Notes</dt>
        <dd>{{#if selectedCamera.notes}}{{selectedCamera.notes}}{{else}}No notes.{{/if}}</dd>
      </dl>

      <div class="security-camera-preview-actions">
        <button type="button" data-security-camera-action="show"><i class="fa-solid fa-tower-broadcast" aria-hidden="true"></i> Show Saved Feed</button>
        <button type="button" data-security-camera-action="close-feed"><i class="fa-solid fa-stop" aria-hidden="true"></i> Close Feeds</button>
      </div>
    </section>
  {{else}}
    <section class="security-camera-monitor-preview">
      <div class="security-camera-empty">No camera selected.</div>
    </section>
  {{/if}}

  <form class="security-camera-editor" data-security-camera-form>
    <header>
      <span class="security-camera-kicker"><i class="fa-solid fa-sliders" aria-hidden="true"></i> Configuration</span>
      <h2>{{#if isNewCamera}}Add Camera{{else}}Edit Camera{{/if}}</h2>
    </header>

    <div class="security-camera-editor-scroll">
    <fieldset class="security-camera-field-group"><legend>Camera identity</legend>
    <p class="security-camera-dirty" data-camera-dirty {{#unless editorDirty}}hidden{{/unless}}>Unsaved changes</p>
    <input type="hidden" name="originalId" value="{{originalEditorId}}">

    <label>
      ID
      <input type="text" name="id" value="{{editorCamera.id}}" placeholder="auto-generated">
    </label>

    <label>
      Name
      <input type="text" name="name" value="{{editorCamera.name}}" required>
    </label>

    <label>
      Location
      <input type="text" name="location" value="{{editorCamera.location}}">
    </label>

    </fieldset>
    <fieldset class="security-camera-field-group"><legend>Scene connection</legend>
    <label>
      Scene
      <select name="sceneId" {{#unless editorCamera.isLive}}disabled{{/unless}}>
        {{#each sceneChoices}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
        {{/each}}
      </select>
    </label>

    <label>
      Scene Region
      <select name="regionId" {{#unless editorCamera.isLive}}disabled{{/unless}}>
        {{#each regionChoices}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
        {{/each}}
      </select>
    </label>

    </fieldset>
    <fieldset class="security-camera-field-group"><legend>Feed settings</legend>
    <label>
      Feed Source
      <select name="feedSource" data-security-camera-feed-source>
        {{#each feedSourceChoices}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </label>

    <label data-security-camera-static-image-field {{#unless showStaticImageField}}hidden{{/unless}}>
      Static Image
      <span class="security-camera-path-row">
        <input type="text" name="image" value="{{editorCamera.image}}">
        <button type="button" data-security-camera-action="browse-image"><i class="fa-solid fa-folder-open" aria-hidden="true"></i> Browse</button>
      </span>
    </label>

    <label>
      Status
      <select name="status">
        {{#each statusChoices}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </label>

    <label>
      Display Mode
      <select name="displayMode">
        {{#each displayModeChoices}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </label>

    <input type="hidden" name="regionX" value="{{editorCamera.regionX}}">
    <input type="hidden" name="regionY" value="{{editorCamera.regionY}}">
    <input type="hidden" name="regionWidth" value="{{editorCamera.regionWidth}}">
    <input type="hidden" name="regionHeight" value="{{editorCamera.regionHeight}}">

    <label>
      Notes
      <textarea name="notes" rows="3">{{editorCamera.notes}}</textarea>
    </label>

    </fieldset>
    </div>
    <div class="security-camera-editor-actions">
      <button type="submit" class="security-camera-primary"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save Camera</button>
      <button type="button" data-security-camera-action="pan-region"><i class="fa-solid fa-crosshairs" aria-hidden="true"></i> Pan to Region</button>
      <button type="button" data-security-camera-action="save-show"><i class="fa-solid fa-tower-broadcast" aria-hidden="true"></i> Save &amp; Show</button>
      <button type="button" data-security-camera-action="close-feed"><i class="fa-solid fa-stop" aria-hidden="true"></i> Close Feeds</button>
    </div>
  </form>
</section>
