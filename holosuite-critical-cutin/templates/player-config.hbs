<form data-holosuite-branding="holosuite-critical-cutin" class="hcci-config">
  <header class="hcci-config-header">
    <div class="hcci-brand">
      <svg viewBox="0 0 32 32" aria-hidden="true"><path d="m16 2 12 7v14l-12 7-12-7V9Zm0 0v14l12 7M4 9l12 7 12-7M16 16v14" fill="none" stroke="currentColor" stroke-width="2"/></svg>
      <strong>HoloSuite</strong>
    </div>
    <div class="hcci-config-title">
      <span data-holosuite-brand-icon><i class="fa-solid fa-bolt" aria-hidden="true"></i></span>
      <h2><span data-holosuite-brand-name>Critical Cut-In</span></h2>
    </div>
    <svg class="hcci-header-trace" viewBox="0 0 440 40" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 2h71l21 18h137l12 12h97l17-16h85M108 14h107l13-12h96m-66 23h74l18-17h54" fill="none" stroke="currentColor"/>
    </svg>
  </header>

  <nav class="hcci-player-tabs" role="tablist" aria-label="Players">
    {{#each players}}
      <button type="button" role="tab" id="hcci-player-{{id}}" aria-controls="hcci-characters-{{id}}" aria-selected="false" tabindex="-1" data-hcci-player="{{id}}">
        <img src="{{avatar}}" alt="">
        <span>{{name}}<small>{{tabDetail}}</small></span>
      </button>
    {{/each}}
  </nav>

  <main class="hcci-config-main">
    {{#each players}}
      <section class="hcci-characters hcci-frame" id="hcci-characters-{{id}}" role="tabpanel" aria-labelledby="hcci-player-{{id}}" data-hcci-characters="{{id}}" hidden>
        <h3><i class="fa-solid fa-users" aria-hidden="true"></i> {{characterHeading}}</h3>
        <div class="hcci-character-list">
          {{#each targets}}
            <button type="button" aria-pressed="false" data-hcci-character="{{key}}">
              <img src="{{portrait}}" alt="">
              <span>{{name}}</span>
            </button>
          {{else}}
            <p class="hcci-empty">This player has no owned characters.</p>
          {{/each}}
        </div>
      </section>
    {{/each}}

    <div class="hcci-workspace" data-hcci-workspace hidden>
      <section class="hcci-preview hcci-frame" aria-label="Cinematic preview">
        <h3><i class="fa-solid fa-eye" aria-hidden="true"></i> Preview <span aria-hidden="true">/</span> <span data-hcci-preview-kind></span></h3>
        <div class="hcci-preview-art">
          <img data-hcci-art alt="">
          <svg class="hcci-art-frame" viewBox="0 0 640 330" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 83 640 0v10L0 99ZM0 311l640-91v17L0 330Z" fill="#1a102e"/>
            <path d="M0 77 640 0v5L0 85ZM0 307l640-91v5L0 314Z" fill="currentColor"/>
            <path d="m18 46 0-18h19m585 17V28h-19M18 288v18h19m585-18v18h-19" fill="none" stroke="currentColor" stroke-width="2.5" vector-effect="non-scaling-stroke"/>
            <path d="m83 67 83-11-10 6-83 12ZM481 246l76-11-11 8-76 11Z" fill="#f6ecff"/>
          </svg>
          <div class="hcci-art-caption" data-hcci-caption></div>
        </div>
        <div class="hcci-preview-actions">
          <div class="hcci-styles">
            <h4 id="hcci-styles-label"><i class="fa-solid fa-clapperboard" aria-hidden="true"></i> Animation Style</h4>
            <div class="hcci-style-list" role="group" aria-labelledby="hcci-styles-label">
              {{#each featuredStyles}}
                <button type="button" aria-pressed="false" title="{{description}}" data-hcci-style="{{id}}">
                  <svg viewBox="0 0 72 28" aria-hidden="true"><use href="modules/holosuite-critical-cutin/assets/ui/style-icons.svg#{{id}}"/></svg>
                  <span>{{label}}</span>
                </button>
              {{/each}}
            </div>
          </div>
          <button class="hcci-primary hcci-test" type="button" data-hcci-test>
            <i class="fa-solid fa-play" aria-hidden="true"></i>
            <span>Test Cut-In <small>Local only</small></span>
          </button>
        </div>
      </section>

      <section class="hcci-editor hcci-frame" aria-label="Cut-in configuration">
        <div class="hcci-outcomes" role="tablist" aria-label="Critical outcome">
          <button type="button" role="tab" id="hcci-success-tab" aria-controls="hcci-settings-panel" aria-selected="true" data-hcci-tab="success">
            <i class="fa-solid fa-check" aria-hidden="true"></i> Critical Success
          </button>
          <button type="button" role="tab" id="hcci-failure-tab" aria-controls="hcci-settings-panel" aria-selected="false" tabindex="-1" data-hcci-tab="failure">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i> Critical Failure
          </button>
        </div>
        <div id="hcci-settings-panel" role="tabpanel" aria-labelledby="hcci-success-tab" class="hcci-settings">
          <h3><i class="fa-solid fa-sliders" aria-hidden="true"></i> Cut-In Settings</h3>
          {{#each rows}}
            <div data-hcci-row="{{key}}" data-hcci-portrait="{{portrait}}" data-hcci-name="{{name}}" {{#if actorId}}data-hcci-actor-id="{{actorId}}"{{/if}} hidden>
              {{#each outcomes}}
                <div class="hcci-fields" data-hcci-panel="{{kind}}" hidden>
                  <label class="hcci-field hcci-toggle">
                    <span>Enabled</span>
                    <input type="checkbox" data-hcci-field="enabled" {{#if enabled}}checked{{/if}}>
                  </label>
                  <label class="hcci-field">
                    <span>Overlay Text</span>
                    <input type="text" data-hcci-field="overlayText" value="{{overlayText}}" placeholder="{{defaultText}}">
                  </label>
                  <label class="hcci-field">
                    <span>Animation Style</span>
                    <select data-hcci-field="animationStyle">
                      {{#each animationStyles}}
                        <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                      {{/each}}
                    </select>
                  </label>
                  <label class="hcci-field">
                    <span data-hcci-{{kind}}-label>Trigger Threshold</span>
                    <input type="number" data-hcci-field="threshold" min="1" max="{{../../dieSides}}" step="1" value="{{threshold}}" title="Leave blank to inherit the global threshold.">
                  </label>
                  <label class="hcci-field">
                    <span>Duration (ms)</span>
                    <input type="number" data-hcci-field="duration" min="800" max="8000" step="1" value="{{duration}}" placeholder="Use global duration">
                  </label>
                  <label class="hcci-field">
                    <span>Accent Color</span>
                    <input type="color" data-hcci-field="accentColor" value="{{accentColor}}">
                  </label>
                  <div class="hcci-field hcci-path-field">
                    <label for="hcci-image-{{../key}}-{{kind}}">Image / Portrait</label>
                    <div>
                      <input id="hcci-image-{{../key}}-{{kind}}" type="text" data-hcci-field="imagePath" value="{{imagePath}}" placeholder="Default portrait">
                      <button type="button" data-hcci-browse="imagePath" aria-label="Choose image" title="Choose image"><i class="fa-solid fa-image" aria-hidden="true"></i></button>
                    </div>
                  </div>
                  <div class="hcci-field hcci-path-field">
                    <label for="hcci-audio-{{../key}}-{{kind}}">Audio Sample</label>
                    <div>
                      <input id="hcci-audio-{{../key}}-{{kind}}" type="text" data-hcci-field="audioPath" value="{{audioPath}}" placeholder="No audio sample">
                      <button type="button" data-hcci-browse="audioPath" aria-label="Choose audio" title="Choose audio"><i class="fa-solid fa-folder-open" aria-hidden="true"></i></button>
                    </div>
                  </div>
                </div>
              {{/each}}
            </div>
          {{/each}}
          <p class="hcci-effect-description" data-hcci-effect-description></p>
        </div>
      </section>
    </div>
  </main>

  <footer class="hcci-footer">
    <details class="hcci-global">
      <summary><i class="fa-solid fa-gear" aria-hidden="true"></i><span>Global Settings <small>Die, thresholds and duration</small></span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
      <div class="hcci-global-fields hcci-frame">
        <label>
          <span>Check Die</span>
          <select name="dieSides" required>
            {{#each dice}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </label>
        <label>
          <span>Positive Rolls</span>
          <select name="rollDirection">
            <option value="high" {{#unless lowRollsGood}}selected{{/unless}}>High rolls are positive</option>
            <option value="low" {{#if lowRollsGood}}selected{{/if}}>Low rolls are positive</option>
          </select>
        </label>
        <label>
          <span data-hcci-success-label>Success threshold</span>
          <input type="number" name="threshold" min="0" max="{{dieSides}}" step="1" value="{{threshold}}">
        </label>
        <label>
          <span data-hcci-failure-label>Failure threshold</span>
          <input type="number" name="failureThreshold" min="0" max="{{dieSides}}" step="1" value="{{failureThreshold}}">
        </label>
        <label>
          <span>Duration (ms)</span>
          <input type="number" name="duration" min="800" max="8000" step="100" value="{{duration}}">
        </label>
        <p>Changing the die or roll direction prompts a threshold reset for every listed entry. Global thresholds of 0 use the best or worst face. Blank character thresholds inherit the global threshold.</p>
      </div>
    </details>
    <div class="hcci-config-actions">
      <span class="hcci-unsaved" data-hcci-dirty role="status" hidden>Unsaved changes</span>
      <button type="button" data-hcci-action="reset" title="Reset all character and GM overrides"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Reset</button>
      <button type="submit" class="hcci-primary"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save Configuration</button>
    </div>
  </footer>
</form>
