{{#if missingMap}}
  <section class="gmf-missing">
    <h2>Galaxy Map Not Found</h2>
    <p>The requested map no longer exists in world settings.</p>
  </section>
{{else}}
  <section class="gmf-galaxy" style="{{#if map.backgroundImage}}--gmf-background-image: url('{{map.backgroundImage}}');{{/if}}">
    <div class="gmf-galaxy__backdrop"></div>
    <header class="gmf-galaxy__header">
      <div>
        <p class="gmf-kicker">{{#if playerMode}}Player Broadcast{{else}}GM Navigation{{/if}}</p>
        <h2>{{map.title}}</h2>
        {{#if map.subtitle}}<p>{{map.subtitle}}</p>{{/if}}
      </div>
      {{#if map.isGM}}
        <div class="gmf-actions">
          {{#unless playerMode}}
            <button type="button" data-action="show-to-players">
              <i class="fa-solid fa-satellite-dish"></i>
              Show
            </button>
          {{/unless}}
        </div>
      {{/if}}
    </header>

    <div class="gmf-galaxy__content">
      {{#if planetView}}
        <main class="gmf-planet-stage" aria-label="System detail view">
          <header class="gmf-planet-heading">
            <button type="button" data-action="back-to-galaxy"><i class="fa-solid fa-arrow-left"></i> Back to Galaxy</button>
            <p class="gmf-kicker">System Detail</p>
            <h3>{{planetSystem.displayName}}</h3>
            <p data-planet-appearance>{{planetAppearance.label}}</p>
          </header>
          <div class="gmf-planet-canvas" data-planet-canvas>
            <div class="gmf-planet-fallback" role="img" aria-label="Static planet preview"></div>
          </div>
          <footer class="gmf-planet-controls">
            <div class="gmf-planet-buttons">
              <button type="button" data-action="planet-pause" data-planet-control aria-pressed="false">Pause rotation</button>
              <button type="button" data-action="planet-zoom-out" data-planet-control aria-label="Zoom out">−</button>
              <button type="button" data-action="planet-zoom-in" data-planet-control aria-label="Zoom in">+</button>
              <button type="button" data-action="planet-reset" data-planet-control>Reset view</button>
              <button type="button" data-action="planet-static" aria-pressed="false">Static view</button>
            </div>
            <p data-planet-status role="status">Preparing model…</p>
          </footer>
        </main>
        {{> "modules/galaxy-map/templates/system-details.hbs" system=planetSystem map=map playerMode=playerMode planetView=true}}
      {{else}}
      <main class="gmf-map-stage" aria-label="Interactive galaxy map">
        <div class="gmf-map-toolbar" aria-label="Map navigation controls">
          <label class="gmf-map-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" value="{{searchQuery}}" placeholder="Find system" data-system-search aria-label="Find a system" />
            <button type="button" data-action="clear-system-search" title="Clear search" {{#unless searchQuery}}hidden{{/unless}}><i class="fa-solid fa-xmark"></i></button>
            <button type="button" data-action="run-system-search" title="Center matching system"><i class="fa-solid fa-location-crosshairs"></i></button>
          </label>
          <span class="gmf-map-toolbar__divider" aria-hidden="true"></span>
          <div class="gmf-map-toolbar__zoom">
            <button type="button" data-action="zoom-out" title="Zoom out"><i class="fa-solid fa-minus"></i></button>
            <span data-zoom-label>{{zoomPercent}}%</span>
            <button type="button" data-action="zoom-in" title="Zoom in"><i class="fa-solid fa-plus"></i></button>
            <button type="button" data-action="reset-view" title="Center and reset view"><i class="fa-solid fa-crosshairs"></i></button>
            <button type="button" data-action="toggle-territories" title="Toggle faction influence regions" aria-label="Faction influence regions" aria-pressed="{{#if showTerritories}}true{{else}}false{{/if}}"><i class="fa-solid fa-layer-group"></i></button>
            {{#if map.canEdit}}
              <button type="button" data-action="open-map-menu" title="Open map actions"><i class="fa-solid fa-bars"></i></button>
            {{/if}}
          </div>
        </div>

        <div class="gmf-map-viewport" style="--gmf-pan-x: {{panX}}px; --gmf-pan-y: {{panY}}px; --gmf-zoom: {{zoom}};">
          {{#if showTerritories}}
            <div class="gmf-territories" aria-hidden="true">
              <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                {{#each territories}}
                  <polygon points="{{points}}" style="--gmf-territory-color: {{color}};" />
                {{/each}}
              </svg>
              {{#each territories}}
                <span class="gmf-territory-label" style="left: {{labelX}}%; top: {{labelY}}%; --gmf-territory-color: {{color}};">{{name}}</span>
              {{/each}}
            </div>
          {{/if}}
          <svg class="gmf-routes" viewBox="0 0 100 100" preserveAspectRatio="none">
            {{#each map.routes as |route|}}
              <line class="gmf-route-hit"
                x1="{{route.from.x}}" y1="{{route.from.y}}"
                x2="{{route.to.x}}" y2="{{route.to.y}}"
                data-route-id="{{route.id}}"
                data-route-from="{{route.fromSystemId}}"
                data-route-to="{{route.toSystemId}}" />
              <line class="gmf-route gmf-route--{{route.type}} {{#if route.isSelected}}is-selected{{/if}} {{#if route.isActive}}is-active{{/if}} {{#if route.gmOnly}}gmf-gm-only{{/if}}"
                data-current-route="{{#if route.connectsCurrent}}true{{else}}false{{/if}}"
                x1="{{route.from.x}}" y1="{{route.from.y}}"
                x2="{{route.to.x}}" y2="{{route.to.y}}"
                data-route-id="{{route.id}}"
                data-route-from="{{route.fromSystemId}}"
                data-route-to="{{route.toSystemId}}" />
            {{/each}}
          </svg>

          <div class="gmf-system-layer">
            {{#each map.systems as |system|}}
              <button type="button"
                class="gmf-system gmf-system--{{system.displayType}} gmf-icon--{{system.iconStyle}} gmf-status--{{system.displayStatus}} {{#if system.animatedCelestial}}gmf-system--animated-celestial{{/if}} {{#if system.isSelected}}is-selected{{/if}} {{#if system.isCurrent}}is-current{{/if}} {{#if system.isDestination}}is-destination{{/if}} {{#if system.hasAlert}}has-alert{{/if}} {{#if system.obscured}}is-obscured{{/if}} {{#if system.gmOnly}}gmf-gm-only{{/if}} {{#unless system.pulse}}gmf-no-pulse{{/unless}} {{#if system.isExternalFocus}}is-external-focus gmf-focus--{{system.externalFocus.kind}}{{/if}}"
                style="left: {{gmfPercent system.x}}; top: {{gmfPercent system.y}}; --gmf-faction-color: {{system.factionColor}}; --gmf-system-size: {{system.iconSize}}px; {{#if system.isExternalFocus}}--gmf-focus-color: {{system.externalFocus.color}};{{/if}}"
                data-system-id="{{system.id}}"
                data-search-text="{{system.displayName}} {{system.displayType}} {{system.displayStatus}} {{system.factionName}}"
                aria-label="{{system.displayName}}, {{system.displayType}}, {{system.displayStatus}}{{#if system.isCurrent}}, current location{{/if}}{{#if system.hasAlert}}, alert{{/if}}"
                aria-pressed="{{#if system.isSelected}}true{{else}}false{{/if}}">
                <span class="gmf-system__halo"></span>
                {{#if system.animatedCelestial}}
                  {{> "modules/galaxy-map/templates/celestial-icon.hbs" system=system}}
                {{else}}
                  <span class="gmf-system__core"></span>
                {{/if}}
                <span class="gmf-system__type-glyph" aria-hidden="true"></span>
                <span class="gmf-system__selection" aria-hidden="true"></span>
                {{#if system.hasAlert}}<span class="gmf-system__alert" title="{{system.alertLabel}}"><i class="fa-solid fa-triangle-exclamation"></i></span>{{/if}}
                {{#if system.isExternalFocus}}
                  <span class="gmf-external-focus" aria-hidden="true">
                    <span class="gmf-external-focus__reticle"></span>
                    <span class="gmf-external-focus__label"><i class="fa-solid fa-tower-broadcast"></i>{{system.externalFocus.label}}</span>
                  </span>
                {{/if}}
                <span class="gmf-system__label">{{system.displayName}}</span>
              </button>
            {{/each}}
          </div>
          <div class="gmf-ship-layer" data-ship-layer></div>
        </div>

        <div class="gmf-intel-layer" data-intel-layer aria-live="polite"></div>

        {{#if map.canEdit}}
          <div class="gmf-map-hint">
            Drag systems to reposition. Click routes to inspect, or right-click the map for editing actions.
          </div>
          <nav class="gmf-context-menu" data-gmf-context-menu hidden>
            <button type="button" data-context-action="add-system" data-context-show="stage">
              <i class="fa-solid fa-plus"></i>
              Add System
            </button>
            <button type="button" data-context-action="add-route" data-context-show="stage">
              <i class="fa-solid fa-route"></i>
              Add Route
            </button>
            <button type="button" data-context-action="manage-factions" data-context-show="stage">
              <i class="fa-solid fa-flag"></i>
              Manage Factions
            </button>
            <button type="button" data-context-action="add-faction" data-context-show="stage">
              <i class="fa-solid fa-plus"></i>
              Add Faction
            </button>
            <button type="button" data-context-action="edit-map-details" data-context-show="stage">
              <i class="fa-solid fa-pen-to-square"></i>
              Edit Map Details
            </button>
            <button type="button" data-context-action="export-map" data-context-show="stage">
              <i class="fa-solid fa-file-export"></i>
              Export Map
            </button>
            <button type="button" data-context-action="edit-system" data-context-show="system">
              <i class="fa-solid fa-pen"></i>
              Edit System
            </button>
            <button type="button" data-context-action="add-system" data-context-show="system">
              <i class="fa-solid fa-plus"></i>
              Add System
            </button>
            <button type="button" data-context-action="add-route-from-system" data-context-show="system">
              <i class="fa-solid fa-route"></i>
              Add Route From Here
            </button>
            <button type="button" data-context-action="reveal-system" data-context-show="system">
              <i class="fa-solid fa-eye"></i>
              Reveal System
            </button>
            <button type="button" data-context-action="hide-system" data-context-show="system">
              <i class="fa-solid fa-eye-slash"></i>
              Hide System
            </button>
            <button type="button" data-context-action="delete-system" data-context-show="system">
              <i class="fa-solid fa-trash"></i>
              Delete System
            </button>
            <button type="button" data-context-action="edit-route" data-context-show="route">
              <i class="fa-solid fa-pen"></i>
              Edit Route
            </button>
            <button type="button" data-context-action="reveal-route" data-context-show="route">
              <i class="fa-solid fa-eye"></i>
              Reveal Route
            </button>
            <button type="button" data-context-action="hide-route" data-context-show="route">
              <i class="fa-solid fa-eye-slash"></i>
              Hide Route
            </button>
            <button type="button" data-context-action="delete-route" data-context-show="route">
              <i class="fa-solid fa-trash"></i>
              Delete Route
            </button>
          </nav>
        {{else}}
          <div class="gmf-map-hint">
            Drag empty space to pan. Scroll to zoom.
          </div>
        {{/if}}
      </main>

      {{> "modules/galaxy-map/templates/system-details.hbs" system=map.selectedSystem route=map.selectedRoute map=map playerMode=playerMode}}
      {{/if}}
    </div>
  </section>
{{/if}}
