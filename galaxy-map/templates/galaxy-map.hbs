{{#if missingMap}}
  <section class="gmf-missing">
    <header class="gmf-galaxy__header" data-gmf-window-drag>
      <div><p class="gmf-kicker">Navigation fault</p><h2>Galaxy Map Not Found</h2></div>
      <button type="button" class="gmf-window-close" data-action="close-window" title="Close" aria-label="Close Galaxy Map"><i class="fa-solid fa-xmark"></i></button>
    </header>
    <p>The requested map no longer exists in world settings.</p>
  </section>
{{else}}
  <section class="gmf-galaxy">
    <div class="gmf-galaxy__backdrop"></div>
    <div class="gmf-frame-drag-strip" data-gmf-window-drag title="Drag window" aria-hidden="true"></div>
    <header class="gmf-galaxy__header" data-gmf-window-drag>
      <div class="gmf-galaxy-identity">
        <div class="gmf-galaxy-identity__row">
          <button type="button" class="gmf-icon-button gmf-layer-up" data-action="navigate-up" title="{{#if planetView}}Back to System{{else}}{{#if activeSystem}}Back to Galaxy{{else}}Galaxy level{{/if}}{{/if}}" aria-label="{{#if planetView}}Back to System{{else}}{{#if activeSystem}}Back to Galaxy{{else}}Galaxy level{{/if}}{{/if}}" {{#unless activeSystem}}disabled aria-disabled="true"{{/unless}}><i class="fa-solid fa-arrow-up"></i></button>
          <span><span class="gmf-galaxy-name">{{map.title}}</span>{{#if activeSystem}}<span class="gmf-chart-name">{{activeSystem.name}}</span>{{/if}}</span>
        </div>
      </div>
      <div class="gmf-actions">
        {{#if systemView}}<button type="button" class="gmf-icon-button gmf-faction-toggle" data-action="toggle-territories" title="Faction regions" aria-label="Faction regions" aria-pressed="{{#if showTerritories}}true{{else}}false{{/if}}"><i class="fa-solid fa-layer-group"></i></button>{{/if}}
        <button type="button" class="gmf-window-close" data-action="close-window" title="Close" aria-label="Close Galaxy Map"><i class="fa-solid fa-xmark"></i></button>
      </div>
    </header>

    <div class="gmf-galaxy__content {{#unless showInspector}}gmf-galaxy__content--map-only{{/unless}}">
      {{#if planetView}}
        <main class="gmf-planet-stage" aria-label="System detail view">
          <div class="gmf-planet-canvas" data-planet-canvas>
            <div class="gmf-planet-fallback" role="img" aria-label="Static planet preview"></div>
          </div>
          <h3 class="gmf-planet-name">{{planetSystem.displayName}}</h3>
          <footer class="gmf-planet-controls">
            <div class="gmf-planet-buttons">
              <button type="button" class="gmf-icon-button" data-action="planet-pause" data-planet-control title="Pause rotation" aria-label="Pause rotation" aria-pressed="false"><i class="fa-solid fa-pause"></i></button>
              <button type="button" class="gmf-icon-button" data-action="planet-zoom-out" data-planet-control title="Zoom out" aria-label="Zoom out"><i class="fa-solid fa-magnifying-glass-minus"></i></button>
              <button type="button" class="gmf-icon-button" data-action="planet-zoom-in" data-planet-control title="Zoom in" aria-label="Zoom in"><i class="fa-solid fa-magnifying-glass-plus"></i></button>
              <button type="button" class="gmf-icon-button" data-action="planet-reset" data-planet-control title="Reset view" aria-label="Reset view"><i class="fa-solid fa-rotate-left"></i></button>
              <button type="button" class="gmf-icon-button" data-action="planet-static" title="Static view" aria-label="Static view" aria-pressed="false"><i class="fa-solid fa-image"></i></button>
            </div>
            <p data-planet-status role="status">Preparing model…</p>
          </footer>
        </main>
        {{> "modules/galaxy-map/templates/system-details.hbs" system=planetSystem map=map playerMode=playerMode planetView=true objectView=true linkedScenes=linkedPlanetScenes linkedJournal=linkedPlanetJournal canEditLinks=canPlacePlanetLocations}}
      {{else}}
      <main class="gmf-map-stage" aria-label="{{#if systemView}}Interactive system chart{{else}}Interactive galaxy map{{/if}}">
        <div class="gmf-map-viewport" style="--gmf-pan-x: {{panX}}px; --gmf-pan-y: {{panY}}px; --gmf-zoom: {{zoom}};">
          {{#if map.backgroundImage}}<img class="gmf-map-background" src="{{map.backgroundImage}}" alt="" aria-hidden="true" />{{/if}}
          {{#if systemView}}{{#if showTerritories}}
            <div class="gmf-territories" aria-hidden="true">
              <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                {{#each territories}}
                  <polygon points="{{points}}" style="--gmf-territory-color: {{color}};" />
                {{/each}}
              </svg>
              {{#each territories}}
                <span class="gmf-territory-label" style="left: {{labelX}}%; top: {{labelY}}%; --gmf-territory-color: {{color}};">{{name}}</span>
              {{/each}}
            </div>
          {{/if}}{{/if}}
          <svg class="gmf-routes" viewBox="0 0 100 100" preserveAspectRatio="none">
            {{#each map.routes as |route|}}
              <line class="gmf-route-hit"
                x1="{{route.from.x}}" y1="{{route.from.y}}"
                x2="{{route.to.x}}" y2="{{route.to.y}}"
                data-route-id="{{route.id}}"
                data-route-from="{{route.fromSystemId}}"
                data-route-to="{{route.toSystemId}}" />
              <line class="gmf-route gmf-route--{{route.type}} {{#if route.isSelected}}is-selected{{/if}} {{#if route.isActive}}is-active{{/if}} {{#if route.gmOnly}}gmf-gm-only{{/if}}"
                data-current-route="{{#if route.connectsCurrent}}true{{else}}false{{/if}}"
                x1="{{route.from.x}}" y1="{{route.from.y}}"
                x2="{{route.to.x}}" y2="{{route.to.y}}"
                data-route-id="{{route.id}}"
                data-route-from="{{route.fromSystemId}}"
                data-route-to="{{route.toSystemId}}" />
            {{/each}}
          </svg>

          <div class="gmf-system-layer">
            {{#each map.systems as |system|}}
              <button type="button"
                class="gmf-system {{#if ../systemView}}gmf-system--{{system.displayType}} gmf-icon--{{system.iconStyle}} {{#if system.animatedCelestial}}gmf-system--animated-celestial{{/if}}{{else}}gmf-system--galaxy-node{{/if}} gmf-status--{{system.displayStatus}} {{#if system.isSelected}}is-selected{{/if}} {{#if system.isCurrent}}is-current{{/if}} {{#if system.isDestination}}is-destination{{/if}} {{#if system.hasAlert}}has-alert{{/if}} {{#if system.obscured}}is-obscured{{/if}} {{#if system.gmOnly}}gmf-gm-only{{/if}} {{#unless system.pulse}}gmf-no-pulse{{/unless}} {{#if system.isExternalFocus}}is-external-focus gmf-focus--{{system.externalFocus.kind}}{{/if}}"
                style="left: {{gmfPercent system.x}}; top: {{gmfPercent system.y}}; --gmf-faction-color: {{system.factionColor}}; --gmf-system-size: {{system.iconSize}}px; {{#if system.isExternalFocus}}--gmf-focus-color: {{system.externalFocus.color}};{{/if}}"
                data-system-id="{{system.id}}"
                data-search-text="{{system.displayName}} {{system.displayType}} {{system.displayStatus}} {{system.factionName}}"
                aria-label="{{system.displayName}}, {{system.displayType}}, {{system.displayStatus}}{{#if system.isCurrent}}, current location{{/if}}{{#if system.hasAlert}}, alert{{/if}}"
                aria-pressed="{{#if system.isSelected}}true{{else}}false{{/if}}">
                <span class="gmf-system__halo"></span>
                {{#if ../systemView}}
                  {{#if system.animatedCelestial}}
                    {{> "modules/galaxy-map/templates/celestial-icon.hbs" system=system}}
                  {{else}}
                    <span class="gmf-system__core"></span>
                  {{/if}}
                {{else}}
                  <span class="gmf-system__core"></span>
                {{/if}}
                {{#if ../systemView}}<span class="gmf-system__type-glyph" aria-hidden="true"></span>{{/if}}
                <span class="gmf-system__selection" aria-hidden="true"></span>
                {{#if system.hasAlert}}<span class="gmf-system__alert" title="{{system.alertLabel}}"><i class="fa-solid fa-triangle-exclamation"></i></span>{{/if}}
                {{#if system.isExternalFocus}}
                  <span class="gmf-external-focus" aria-hidden="true">
                    <span class="gmf-external-focus__reticle"></span>
                    <span class="gmf-external-focus__label"><i class="fa-solid fa-tower-broadcast"></i>{{system.externalFocus.label}}</span>
                  </span>
                {{/if}}
                <span class="gmf-system__label">{{system.displayName}}</span>
              </button>
            {{/each}}
          </div>
          <div class="gmf-ship-layer" data-ship-layer></div>
        </div>

        <div class="gmf-intel-layer" data-intel-layer aria-live="polite"></div>

        {{#if map.canEdit}}
          <div class="gmf-map-hint">
            {{#if systemView}}Drag entities to arrange this system. Right-click empty space to add an entity.{{else}}Drag systems to reposition. Click routes to inspect, or right-click the map for editing actions.{{/if}}
          </div>
          {{#if systemView}}
          <nav class="gmf-context-menu" data-gmf-context-menu hidden>
            <button type="button" data-context-action="add-entity" data-context-show="stage"><i class="fa-solid fa-plus"></i>Add Entity</button>
            <button type="button" data-context-action="manage-factions" data-context-show="stage"><i class="fa-solid fa-flag"></i>Manage Factions</button>
            <button type="button" data-context-action="add-faction" data-context-show="stage"><i class="fa-solid fa-plus"></i>Add Faction</button>
            <button type="button" data-context-action="edit-entity" data-context-show="system"><i class="fa-solid fa-pen"></i>Edit Entity</button>
            <button type="button" data-context-action="add-entity" data-context-show="system"><i class="fa-solid fa-plus"></i>Add Entity</button>
            <button type="button" data-context-action="reveal-entity" data-context-show="system"><i class="fa-solid fa-eye"></i>Reveal Entity</button>
            <button type="button" data-context-action="hide-entity" data-context-show="system"><i class="fa-solid fa-eye-slash"></i>Hide Entity</button>
            <button type="button" data-context-action="delete-entity" data-context-show="system"><i class="fa-solid fa-trash"></i>Delete Entity</button>
          </nav>
          {{else}}<nav class="gmf-context-menu" data-gmf-context-menu hidden>
            <button type="button" data-context-action="add-system" data-context-show="stage">
              <i class="fa-solid fa-plus"></i>
              Add System
            </button>
            <button type="button" data-context-action="add-route" data-context-show="stage">
              <i class="fa-solid fa-route"></i>
              Add Route
            </button>
            <button type="button" data-context-action="manage-factions" data-context-show="stage">
              <i class="fa-solid fa-flag"></i>
              Manage Factions
            </button>
            <button type="button" data-context-action="add-faction" data-context-show="stage">
              <i class="fa-solid fa-plus"></i>
              Add Faction
            </button>
            <button type="button" data-context-action="edit-map-details" data-context-show="stage">
              <i class="fa-solid fa-pen-to-square"></i>
              Edit Map Details
            </button>
            <button type="button" data-context-action="export-map" data-context-show="stage">
              <i class="fa-solid fa-file-export"></i>
              Export Map
            </button>
            <button type="button" data-context-action="edit-system" data-context-show="system">
              <i class="fa-solid fa-pen"></i>
              Edit System
            </button>
            <button type="button" data-context-action="add-system" data-context-show="system">
              <i class="fa-solid fa-plus"></i>
              Add System
            </button>
            <button type="button" data-context-action="add-route-from-system" data-context-show="system">
              <i class="fa-solid fa-route"></i>
              Add Route From Here
            </button>
            <button type="button" data-context-action="reveal-system" data-context-show="system">
              <i class="fa-solid fa-eye"></i>
              Reveal System
            </button>
            <button type="button" data-context-action="hide-system" data-context-show="system">
              <i class="fa-solid fa-eye-slash"></i>
              Hide System
            </button>
            <button type="button" data-context-action="delete-system" data-context-show="system">
              <i class="fa-solid fa-trash"></i>
              Delete System
            </button>
            <button type="button" data-context-action="edit-route" data-context-show="route">
              <i class="fa-solid fa-pen"></i>
              Edit Route
            </button>
            <button type="button" data-context-action="reveal-route" data-context-show="route">
              <i class="fa-solid fa-eye"></i>
              Reveal Route
            </button>
            <button type="button" data-context-action="hide-route" data-context-show="route">
              <i class="fa-solid fa-eye-slash"></i>
              Hide Route
            </button>
            <button type="button" data-context-action="delete-route" data-context-show="route">
              <i class="fa-solid fa-trash"></i>
              Delete Route
            </button>
          </nav>{{/if}}
        {{else}}
          <div class="gmf-map-hint">
            Drag empty space to pan. Scroll to zoom.
          </div>
        {{/if}}
      </main>

      {{#if showInspector}}{{> "modules/galaxy-map/templates/system-details.hbs" system=map.selectedSystem route=map.selectedRoute map=map playerMode=playerMode objectView=systemView linkedScenes=linkedPlanetScenes linkedJournal=linkedPlanetJournal canEditLinks=canPlacePlanetLocations}}{{/if}}
      {{/if}}
    </div>
  </section>
{{/if}}
