<section class="gmf-manager">
  <header class="gmf-manager__header">
    <div>
      <p class="gmf-kicker">Galaxy Map Framework</p>
      <h2>Map Manager</h2>
    </div>
    <button type="button" class="gmf-button gmf-button--primary" data-action="create-map">
      <i class="fa-solid fa-plus"></i>
      Create Map
    </button>
  </header>

  <div class="gmf-manager__body">
    <aside class="gmf-map-list" aria-label="Galaxy maps">
      {{#if hasMaps}}
        {{#each maps as |map|}}
          <button type="button"
            class="gmf-map-card {{#if (gmfEq ../selectedMapId map.id)}}is-selected{{/if}}"
            data-select-map="{{map.id}}"
            aria-pressed="{{#if (gmfEq ../selectedMapId map.id)}}true{{else}}false{{/if}}">
            <span class="gmf-map-card__copy">
              <strong class="gmf-map-card__title">{{map.title}}</strong>
              <span class="gmf-map-card__meta">{{gmfFallback map.subtitle "No subtitle"}}</span>
            </span>
            <span class="gmf-map-card__stats" aria-label="Map contents">
              <span><strong>{{map.systems.length}}</strong> systems</span>
              <span><strong>{{map.routes.length}}</strong> routes</span>
              <span class="gmf-visibility-state gmf-visibility-state--{{map.visibility}}">
                <i class="fa-solid {{#if (gmfEq map.visibility "players")}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>
                {{map.visibility}}
              </span>
            </span>
          </button>
        {{/each}}
      {{else}}
        <div class="gmf-empty">
          <i class="fa-solid fa-star"></i>
          <p>No galaxy maps yet.</p>
        </div>
      {{/if}}
    </aside>

    <main class="gmf-manager-preview">
      {{#if selectedMap}}
        <header class="gmf-manager-preview__panel">
          <div class="gmf-manager-preview__identity">
            <p class="gmf-kicker">Selected Map</p>
            <h3>{{selectedMap.title}}</h3>
            <p>{{gmfFallback selectedMap.subtitle "No subtitle"}}</p>
            <p class="gmf-manager-preview__travel"><i class="fa-solid fa-users"></i> Travel: {{selectedMap.travelApprovalModeLabel}}</p>
          </div>
          <div class="gmf-manager-toolbar" aria-label="Selected map actions">
            <div class="gmf-manager-toolbar__primary">
              <button type="button" class="gmf-button gmf-button--primary" data-open-map="{{selectedMap.id}}">
                <i class="fa-solid fa-map-location-dot"></i>
                Open Map
              </button>
              <button type="button" class="gmf-button gmf-button--accent" data-show-map="{{selectedMap.id}}">
                <i class="fa-solid fa-satellite-dish"></i>
                Show to Players
              </button>
            </div>
            <div class="gmf-manager-toolbar__secondary">
              <button type="button" class="gmf-button gmf-button--quiet" data-action="edit-map-metadata">
                <i class="fa-solid fa-pen-to-square"></i>
                Edit
              </button>
              <button type="button" class="gmf-button gmf-button--quiet" data-action="close-player-map">
                <i class="fa-solid fa-eye-slash"></i>
                Close Player View
              </button>
              <details class="gmf-overflow-menu">
                <summary title="More map actions"><i class="fa-solid fa-ellipsis"></i><span>More</span></summary>
                <div class="gmf-overflow-menu__panel">
                  <button type="button" data-duplicate-map="{{selectedMap.id}}"><i class="fa-solid fa-copy"></i>Duplicate</button>
                  <button type="button" data-action="export-map"><i class="fa-solid fa-file-export"></i>Export</button>
                  <button type="button" class="gmf-button--danger" data-delete-map="{{selectedMap.id}}"><i class="fa-solid fa-trash"></i>Delete Map</button>
                </div>
              </details>
            </div>
          </div>
        </header>

        <section class="gmf-crud-editor">
          <div class="gmf-crud-editor__bar">
            <div>
              <p class="gmf-kicker">Map Contents</p>
              <h3>Navigation Registry</h3>
            </div>
            <div class="gmf-creation-actions" aria-label="Create map content">
              <button type="button" data-action="create-system"><i class="fa-solid fa-plus"></i>System</button>
              <button type="button" data-action="create-route"><i class="fa-solid fa-plus"></i>Route</button>
              <button type="button" data-action="create-faction"><i class="fa-solid fa-plus"></i>Faction</button>
            </div>
          </div>

          <nav class="gmf-manager-tabs" role="tablist" aria-label="Map content type">
            <button type="button" role="tab" data-manager-tab="systems" aria-selected="{{#if showSystems}}true{{else}}false{{/if}}" class="{{#if showSystems}}is-active{{/if}}">
              Systems <span>{{selectedMap.systems.length}}</span>
            </button>
            <button type="button" role="tab" data-manager-tab="routes" aria-selected="{{#if showRoutes}}true{{else}}false{{/if}}" class="{{#if showRoutes}}is-active{{/if}}">
              Routes <span>{{selectedMap.routes.length}}</span>
            </button>
            <button type="button" role="tab" data-manager-tab="factions" aria-selected="{{#if showFactions}}true{{else}}false{{/if}}" class="{{#if showFactions}}is-active{{/if}}">
              Factions <span>{{selectedMap.factions.length}}</span>
            </button>
          </nav>

          <div class="gmf-manager-tabpanels">
            {{#if showSystems}}
              <section class="gmf-crud-section" role="tabpanel" aria-label="Systems">
                <div class="gmf-crud-list">
                  {{#each selectedMap.systems as |system|}}
                    <article class="gmf-crud-row">
                      <div class="gmf-crud-row__identity">
                        <strong>{{system.name}}</strong>
                        <span class="gmf-row-tags">
                          <span>{{system.type}}</span><span>{{system.status}}</span>
                          {{#if system.factionId}}<span>{{system.factionName}}</span>{{/if}}
                          {{#if system.sceneIds.length}}<span>{{system.sceneIds.length}} scene links</span>{{/if}}
                        </span>
                      </div>
                      <span class="gmf-visibility-state gmf-visibility-state--{{system.visibility}}"><i class="fa-solid {{#if (gmfEq system.visibility "players")}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>{{system.visibility}}</span>
                      <div class="gmf-row-actions">
                        <button type="button" data-edit-system="{{system.id}}" title="Edit system" aria-label="Edit {{system.name}}"><i class="fa-solid fa-pen"></i></button>
                        {{#if (gmfEq system.visibility "players")}}
                          <button type="button" data-hide-system="{{system.id}}" title="Hide from players" aria-label="Hide {{system.name}} from players"><i class="fa-solid fa-eye-slash"></i></button>
                        {{else}}
                          <button type="button" data-show-system="{{system.id}}" title="Show to players" aria-label="Show {{system.name}} to players"><i class="fa-solid fa-eye"></i></button>
                        {{/if}}
                        <button type="button" class="gmf-button--danger" data-delete-system="{{system.id}}" title="Delete system" aria-label="Delete {{system.name}}"><i class="fa-solid fa-trash"></i></button>
                      </div>
                    </article>
                  {{else}}
                    <p class="gmf-empty-inline">No systems yet. Add a system to begin charting this map.</p>
                  {{/each}}
                </div>
              </section>
            {{/if}}

            {{#if showRoutes}}
              <section class="gmf-crud-section" role="tabpanel" aria-label="Routes">
                <div class="gmf-crud-list">
                  {{#each selectedMap.routes as |route|}}
                    <article class="gmf-crud-row">
                      <div class="gmf-crud-row__identity">
                        <strong>{{route.fromName}} <i class="fa-solid fa-arrow-right-long"></i> {{route.toName}}</strong>
                        <span class="gmf-row-tags"><span>{{route.type}}</span><span>{{gmfFallback route.travelTime "Unknown transit time"}}</span><span>Fuel {{route.fuelCost}}</span></span>
                      </div>
                      <span class="gmf-visibility-state gmf-visibility-state--{{route.visibility}}"><i class="fa-solid {{#if (gmfEq route.visibility "players")}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>{{route.visibility}}</span>
                      <div class="gmf-row-actions">
                        <button type="button" data-edit-route="{{route.id}}" title="Edit route" aria-label="Edit route from {{route.fromName}} to {{route.toName}}"><i class="fa-solid fa-pen"></i></button>
                        {{#if (gmfEq route.visibility "players")}}
                          <button type="button" data-hide-route="{{route.id}}" title="Hide from players" aria-label="Hide route from players"><i class="fa-solid fa-eye-slash"></i></button>
                        {{else}}
                          <button type="button" data-show-route="{{route.id}}" title="Show to players" aria-label="Show route to players"><i class="fa-solid fa-eye"></i></button>
                        {{/if}}
                        <button type="button" class="gmf-button--danger" data-delete-route="{{route.id}}" title="Delete route" aria-label="Delete route"><i class="fa-solid fa-trash"></i></button>
                      </div>
                    </article>
                  {{else}}
                    <p class="gmf-empty-inline">No routes yet. Add a route between two charted systems.</p>
                  {{/each}}
                </div>
              </section>
            {{/if}}

            {{#if showFactions}}
              <section class="gmf-crud-section" role="tabpanel" aria-label="Factions">
                <div class="gmf-crud-list">
                  {{#each selectedMap.factions as |faction|}}
                    <article class="gmf-crud-row">
                      <div class="gmf-crud-row__identity">
                        <strong><span class="gmf-color-dot" style="--gmf-faction-color: {{faction.color}};"></span>{{faction.name}}</strong>
                        <span>{{gmfFallback faction.description "No faction description."}}</span>
                      </div>
                      <span class="gmf-visibility-state gmf-visibility-state--{{faction.visibility}}"><i class="fa-solid {{#if (gmfEq faction.visibility "players")}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>{{faction.visibility}}</span>
                      <div class="gmf-row-actions">
                        <button type="button" data-edit-faction="{{faction.id}}" title="Edit faction" aria-label="Edit {{faction.name}}"><i class="fa-solid fa-pen"></i></button>
                        {{#if (gmfEq faction.visibility "players")}}
                          <button type="button" data-hide-faction="{{faction.id}}" title="Hide from players" aria-label="Hide {{faction.name}} from players"><i class="fa-solid fa-eye-slash"></i></button>
                        {{else}}
                          <button type="button" data-show-faction="{{faction.id}}" title="Show to players" aria-label="Show {{faction.name}} to players"><i class="fa-solid fa-eye"></i></button>
                        {{/if}}
                        <button type="button" class="gmf-button--danger" data-delete-faction="{{faction.id}}" title="Delete faction" aria-label="Delete {{faction.name}}"><i class="fa-solid fa-trash"></i></button>
                      </div>
                    </article>
                  {{else}}
                    <p class="gmf-empty-inline">No factions yet. Systems can remain unaffiliated.</p>
                  {{/each}}
                </div>
              </section>
            {{/if}}
          </div>
        </section>
      {{else}}
        <div class="gmf-empty gmf-empty--large">
          <i class="fa-solid fa-circle-nodes"></i>
          <p>Create a map to begin charting systems and routes.</p>
        </div>
      {{/if}}
    </main>
  </div>
</section>
