<section class="cybercall-phone-shell cybercall-phone-{{mode}}" data-holosuite-branding="cybercall">
  {{#if isCallScreen}}
    {{> "modules/cybercall/templates/cybercall.hbs"}}
  {{else}}
    <header class="cybercall-device-status">
      <span><span data-holosuite-brand-icon></span><strong data-holosuite-brand-name>CyberCall</strong></span>
      <span class="cybercall-device-status-actions"><span class="cybercall-device-status-icon"><i class="fa-solid fa-satellite-dish" aria-hidden="true"></i></span><span data-cybercall-window-controls></span></span>
    </header>
    <div class="cybercall-device-screen">
      {{#if isContactsMode}}{{> "modules/cybercall/templates/cybercall-contacts.hbs"}}{{/if}}
      {{#if isMessagesMode}}{{> "modules/cybercall/templates/cybercall-messages.hbs"}}{{/if}}
      {{#if isHistoryMode}}
        <section class="cybercall-phone-page">
          <h2>Call history</h2>
          <ul class="cybercall-history-list">
            {{#each history}}
              <li class="cybercall-history-{{eventType}}"><i class="fa-solid fa-phone" aria-hidden="true"></i><div>{{body}}{{#if createdAtLabel}}<time>{{createdAtLabel}}</time>{{/if}}</div></li>
            {{else}}<li>No recorded calls.</li>{{/each}}
          </ul>
        </section>
      {{/if}}
      {{#if isSettingsMode}}{{> "modules/cybercall/templates/cybercall-contacts.hbs"}}{{/if}}
    </div>
    <nav class="cybercall-device-nav" aria-label="CyberCall screens">
      <button type="button" data-cybercall-screen="calls" {{#if isContactsMode}}aria-current="page"{{/if}}><i class="fa-solid fa-address-book" aria-hidden="true"></i>Contacts</button>
      <button type="button" data-cybercall-screen="messages" {{#if isMessagesMode}}aria-current="page"{{/if}}><i class="fa-solid fa-comment" aria-hidden="true"></i>Messages{{#if hasUnreadMessages}} <span class="cybercall-unread-label">{{#if unreadCount}}{{unreadCount}}{{else}}{{unreadMessageCount}}{{/if}}</span>{{/if}}</button>
      <button type="button" data-cybercall-screen="history" {{#if isHistoryMode}}aria-current="page"{{/if}}><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>History</button>
      <button type="button" data-cybercall-screen="settings" {{#if isSettingsMode}}aria-current="page"{{/if}}><i class="fa-solid fa-gear" aria-hidden="true"></i>Settings</button>
    </nav>
  {{/if}}
</section>
